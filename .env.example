# Copia este archivo como .env y completa los valores
# La información sensible nunca se sube al repositorio

# Nombre de la aplicación
VITE_APP_NAME=Multicine

# URL base de la API (Postman Mock Server para desarrollo)
VITE_API_URL=https://e02d0949-b2e0-466d-a72f-c874299880bb.mock.pstmn.io

# Tiempo máximo de espera de las peticiones (milisegundos)
VITE_API_TIMEOUT=10000

# Entorno de ejecución (development | production)
VITE_APP_ENV=

# Claves públicas de servicios externos
VITE_PUBLIC_KEY=

